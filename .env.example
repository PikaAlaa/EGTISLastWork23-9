# Local SQLite is automatic if DATABASE_URL is omitted. PostgreSQL is supported.
# DATABASE_URL=postgresql://etis:YOUR_PASSWORD@localhost:5432/etis
ETIS_API_KEY=
ETIS_TEXT_MODEL=char
ETIS_CHAR_MODEL_PATH=ml/models/deployed_char.joblib
ETIS_RETENTION_DAYS=30
ETIS_BLACKLIST_MAX_AGE_DAYS=30
# Character artifact carries its validation-selected thresholds. These apply to BiLSTM fallback.
ETIS_TEXT_LOW_THRESHOLD=0.2
ETIS_TEXT_HIGH_THRESHOLD=0.8
ETIS_RATE_LIMIT=20/minute
# Core v1: record hash-only findings/incidents for scans (0 = pre-core behaviour). Never changes verdicts.
ETIS_FINDINGS_ENABLED=1
ETIS_CORRELATION_WINDOW_DAYS=14
# Host engine: HMAC key for host/account pseudonyms; scripts/initialize.py fills it in .env. Never share it.
ETIS_HOST_PSEUDONYM_KEY=
# Malware engine: HMAC key for path_ref pseudonyms (docs/design/malware-engine-v1.md section 7). Never share it.
ETIS_MALWARE_PSEUDONYM_KEY=
# Malware engine: days before scan-derived Findings and scan records expire.
ETIS_MALWARE_RETENTION_DAYS=30
# Network engines: days before import-derived Findings and import records expire.
ETIS_NETWORK_RETENTION_DAYS=30
# Core v2 / LAN server: server-only HMAC key that wraps stored device and account refs to srv: (docs/design/core-v2.md §3.2).
# Generated by `python scripts/initialize.py --env-only`. Back up .env alongside every database backup.
ETIS_SERVER_REF_KEY=
# Core v2: per-installation UUID namespace for deterministic STIX 2.1 indicator/incident IDs (docs/design/core-v2.md §1.6).
ETIS_STIX_NAMESPACE=
# Docker Compose LAN server bind address (RFC 1918 private LAN IP or 127.0.0.1; never 0.0.0.0 or a public IP).
ETIS_LAN_BIND_IP=127.0.0.1
