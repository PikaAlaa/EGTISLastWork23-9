# Local SQLite is automatic if DATABASE_URL is omitted. PostgreSQL is supported.
# DATABASE_URL=postgresql://etis:YOUR_PASSWORD@localhost:5432/etis
ETIS_API_KEY=
ETIS_TEXT_MODEL=char
ETIS_CHAR_MODEL_PATH=ml/models/deployed_char.joblib
ETIS_RETENTION_DAYS=30
ETIS_BLACKLIST_MAX_AGE_DAYS=30
# Character artifact carries its validation-selected thresholds. These apply to BiLSTM fallback.
ETIS_TEXT_LOW_THRESHOLD=0.2
ETIS_TEXT_HIGH_THRESHOLD=0.8
ETIS_RATE_LIMIT=20/minute
